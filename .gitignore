# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Project data / model / figure artifacts (keep .gitkeep placeholders)
data/*
!data/.gitkeep
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/interim/
data/interim/*
!data/interim/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep

models/*
!models/.gitkeep

reports/figures/*
!reports/figures/.gitkeep

reports/metrics/*
!reports/metrics/.gitkeep

# docs/images/ is a curated, tracked subset of figures for display in
# README.md -- not a second generated-output directory like reports/figures/.
!docs/
!docs/images/
!docs/images/*

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
